# Staging environment variables
# Copy this file to terraform.tfvars and customize

aws_region = "us-west-2"
environment = "stage"
project_name = "golden-repo"
repository_name = "terraform-golden-repo"  # Change this to your repo name

common_tags = {
  Environment = "stage"
  ManagedBy   = "terraform"
  Project     = "golden-repo"
  Owner       = "staging-team"
}